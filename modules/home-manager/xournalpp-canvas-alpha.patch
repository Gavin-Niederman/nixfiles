     // Draw background
     Settings* settings = xournal->view->getControl()->getSettings();
-    Util::cairo_set_source_rgbi(cr, settings->getBackgroundColor());
+    // Patched: honour the alpha of the background colour, and paint it with
+    // CAIRO_OPERATOR_SOURCE so it replaces (clears) rather than composites
+    // over whatever the buffer held before; a translucent colour would
+    // otherwise stack on every repaint.
+    cairo_save(cr);
+    cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
+    Util::cairo_set_source_argb(cr, settings->getBackgroundColor());
     cairo_paint(cr);
+    cairo_restore(cr);
 
